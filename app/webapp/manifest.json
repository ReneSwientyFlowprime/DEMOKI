{
  "_version": "1.65.0",
  "sap.app": {
    "id": "zrefdocphoto",
    "type": "application",
    "i18n": "i18n/i18n.properties",
    "applicationVersion": {
      "version": "1.0.0"
    },
    "title": "{{appTitle}}",
    "description": "{{appDescription}}",
    "resources": "resources.json",
    "sourceTemplate": {
      "id": "@sap/generator-fiori:lrop",
      "version": "1.0.0"
    },
    "dataSources": {
      "mainService": {
        "uri": "/sap/opu/odata4/sap/zui_refdoc_photo/srvd_a2x/sap/zui_refdoc_photo/0001/",
        "type": "OData",
        "settings": {
          "annotations": [],
          "localUri": "localService/metadata.xml",
          "odataVersion": "4.0"
        }
      }
    }
  },
  "sap.ui": {
    "technology": "UI5",
    "icons": {
      "icon": "sap-icon://camera"
    },
    "deviceTypes": {
      "desktop": true,
      "tablet": true,
      "phone": true
    }
  },
  "sap.ui5": {
    "flexEnabled": true,
    "dependencies": {
      "minUI5Version": "1.120.0",
      "libs": {
        "sap.m": {},
        "sap.ui.core": {},
        "sap.fe.templates": {}
      }
    },
    "models": {
      "i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "settings": {
          "bundleName": "zrefdocphoto.i18n.i18n"
        }
      },
      "": {
        "dataSource": "mainService",
        "settings": {
          "synchronizationMode": "None",
          "operationMode": "Server",
          "autoExpandSelect": true,
          "earlyRequests": true
        }
      }
    },
    "resources": {
      "css": []
    },
    "routing": {
      "config": {},
      "routes": [
        {
          "pattern": ":?query:",
          "name": "RefDocList",
          "target": "RefDocList"
        },
        {
          "pattern": "RefDoc({key}):?query:",
          "name": "RefDocObjectPage",
          "target": "RefDocObjectPage"
        }
      ],
      "targets": {
        "RefDocList": {
          "type": "Component",
          "id": "RefDocList",
          "name": "sap.fe.templates.ListReport",
          "options": {
            "settings": {
              "entitySet": "RefDoc",
              "variantManagement": "Page",
              "navigation": {
                "RefDoc": {
                  "detail": {
                    "route": "RefDocObjectPage"
                  }
                }
              }
            }
          }
        },
        "RefDocObjectPage": {
          "type": "Component",
          "id": "RefDocObjectPage",
          "name": "sap.fe.templates.ObjectPage",
          "options": {
            "settings": {
              "entitySet": "RefDoc"
            }
          }
        }
      }
    }
  }
}
