@Metadata.layer: #CORE

@UI: {
  headerInfo: {
    typeName: 'Referenzbeleg',
    typeNamePlural: 'Referenzbelege',
    title: { type: #STANDARD, value: 'ReferenceNumber' },
    description: { type: #STANDARD, value: 'ReferenceType' }
  },
  presentationVariant: [{ sortOrder: [{ by: 'CreatedAt', direction: #DESC }] }]
}

annotate entity ZC_RefDoc with
{
  @UI.facet: [
    { id: 'Header',
      purpose: #STANDARD,
      type: #IDENTIFICATION_REFERENCE,
      label: 'Belegdaten',
      position: 10 },
    { id: 'Photos',
      purpose: #STANDARD,
      type: #LINEITEM_REFERENCE,
      label: 'Fotos',
      targetElement: '_Photo',
      position: 20 }
  ]

  @UI.lineItem: [ { position: 10, importance: #HIGH } ]
  @UI.identification: [ { position: 10 } ]
  @UI.selectionField: [ { position: 10 } ]
  @Consumption.valueHelpDefinition: [ { entity: { name: 'ZI_RefDocType', element: 'ReferenceType' } } ]
  ReferenceType;

  @UI.lineItem: [ { position: 20, importance: #HIGH } ]
  @UI.identification: [ { position: 20 } ]
  @UI.selectionField: [ { position: 20 } ]
  ReferenceNumber;

  @UI.lineItem: [ { position: 30 } ]
  @UI.identification: [ { position: 30 } ]
  CreatedBy;

  @UI.lineItem: [ { position: 40 } ]
  @UI.identification: [ { position: 40 } ]
  CreatedAt;

  @UI.hidden: true
  LastChangedBy;

  @UI.hidden: true
  LastChangedAt;

  @UI.hidden: true
  LocalLastChangedAt;
}
